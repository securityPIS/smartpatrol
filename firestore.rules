// Tujuan: Mengunci Firestore SmartPatrol agar shared-state dan domain reports hanya bisa diakses user operasional approved.
// Caller: Firebase Firestore rules engine untuk client web SmartPatrol.
// Dependensi: Koleksi sidecar userAccess/{uid} dan pendingRegistrations/{uid}.
// Main Functions: Mengizinkan shared-state/domain reports untuk userAccess enabled, create onboarding publik terbatas, dan read admin/owner.
// Side Effects: Menolak write publik ke state operasional/domain dan membatasi approval ke callable/admin SDK.

rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function userAccessDoc() {
      return get(/databases/$(database)/documents/userAccess/$(request.auth.uid));
    }

    function hasUserAccessDoc() {
      return isSignedIn() && exists(/databases/$(database)/documents/userAccess/$(request.auth.uid));
    }

    function isAdmin() {
      return hasUserAccessDoc()
        && userAccessDoc().data.role == 'ADMIN'
        && userAccessDoc().data.enabled == true;
    }

    function hasOperationalSharedStateAccess() {
      return hasUserAccessDoc()
        && userAccessDoc().data.enabled == true
        && userAccessDoc().data.reviewState == 'approved';
    }

    function isAssignedOperationalShip(shipName) {
      return hasOperationalSharedStateAccess()
        && shipName is string
        && userAccessDoc().data.shipAssigned == shipName;
    }

    function canReadPatrolReport() {
      return hasOperationalSharedStateAccess()
        && (isAdmin() || isAssignedOperationalShip(resource.data.shipName));
    }

    function hasValidPatrolReportKeys() {
      return request.resource.data.keys().hasOnly([
        'schemaVersion',
        'clientUpdatedAt',
        'serverUpdatedAt',
        'firestoreId',
        'id',
        'checkpointId',
        'checkpointName',
        'name',
        'desc',
        'status',
        'pendingOrigin',
        'isTemporaryShiftNode',
        'createdInShiftKey',
        'shipId',
        'shipName',
        'shiftKey',
        'incidentId',
        'completedBy',
        'completedByUserId',
        'date',
        'time',
        'completedAt',
        'updatedAt',
        'resultType',
        'photoUrl',
        'galleryPhotos',
        'mediaStatus',
        'kejadian',
        'penyebab',
        'tindakLanjut',
        'shipSnapshot',
        'gpsSnapshot',
        'weatherSnapshot',
        'occurredAtTrustedMs',
        'receivedAtServerMs',
        'timeTrustLevel',
        'verificationStatus',
        'clockTamperDetected'
      ]);
    }

    function isValidPatrolReportWrite(shiftKey, shipId, checkpointId) {
      return hasOperationalSharedStateAccess()
        && hasValidPatrolReportKeys()
        && request.resource.data.schemaVersion == 1
        && request.resource.data.clientUpdatedAt is number
        && request.resource.data.serverUpdatedAt == request.time
        && request.resource.data.shiftKey == shiftKey
        && request.resource.data.shipId == shipId
        && request.resource.data.checkpointId == checkpointId
        && request.resource.data.shipName is string
        && request.resource.data.status in ['pending', 'completed', 'missed']
        && request.resource.data.mediaStatus in ['none', 'uploading', 'ready', 'failed']
        && (request.resource.data.resultType == null
          || request.resource.data.resultType in ['aman', 'temuan', 'missed'])
        && (isAdmin() || isAssignedOperationalShip(request.resource.data.shipName));
    }

    function hasValidIncidentReportSignalKeys() {
      return request.resource.data.keys().hasAny([
        'schemaVersion',
        'clientUpdatedAt',
        'serverUpdatedAt',
        'id',
        'incidentId',
        'location',
        'deskripsi',
        'penyebab',
        'tindakLanjut',
        'reportedBy',
        'shipName',
        'photoUrl',
        'status',
        'createdAt',
        'updatedAt',
        'progress',
        'documentation',
        'infoOverrides',
        'date',
        'time',
        'isSOS',
        'isPatrol',
        'occurredAtTrustedMs',
        'occurredAtTrustedIso',
        'receivedAtServerMs',
        'timeTrustLevel',
        'clockTamperDetected'
      ]);
    }

    function isValidIncidentReportWrite(incidentId) {
      return hasOperationalSharedStateAccess()
        && hasValidIncidentReportSignalKeys()
        && request.resource.data.schemaVersion == 1
        && request.resource.data.clientUpdatedAt is number
        && request.resource.data.serverUpdatedAt == request.time
        && request.resource.data.id == incidentId
        && request.resource.data.shipName is string
        && (request.resource.data.status == null
          || request.resource.data.status in ['open', 'closed', 'active', 'resolved'])
        && (isAdmin() || isAssignedOperationalShip(request.resource.data.shipName));
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    match /smartpatrol/shared-state {
      allow read, write: if hasOperationalSharedStateAccess();
    }

    match /smartpatrol/shared-signal {
      allow read, write: if hasOperationalSharedStateAccess();
    }

    match /smartpatrol/{document=**} {
      allow read, write: if false;
    }

    match /patrolReports/{shiftKey}/ships/{shipId}/checkpoints/{checkpointId} {
      allow read: if canReadPatrolReport();
      allow create, update: if isValidPatrolReportWrite(shiftKey, shipId, checkpointId);
      allow delete: if false;
    }

    match /incidents/{incidentId} {
      allow read: if hasOperationalSharedStateAccess();
      allow create, update: if isValidIncidentReportWrite(incidentId);
      allow delete: if isAdmin();
    }

    match /pendingRegistrations/{uid} {
      allow create: if isOwner(uid)
        && !exists(/databases/$(database)/documents/pendingRegistrations/$(uid))
        && request.resource.data.keys().hasOnly([
          'uid',
          'email',
          'name',
          'phone',
          'photoUrl',
          'photoPath',
          'type',
          'workerNumber',
          'status',
          'createdAt',
          'updatedAt',
          'reviewedAt',
          'reviewedBy',
          'reviewNote'
        ])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.status == 'pending'
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time
        && request.resource.data.reviewedAt == null
        && request.resource.data.reviewedBy == ''
        && request.resource.data.reviewNote == '';

      allow read: if isOwner(uid) || isAdmin();
      allow update, delete: if false;
    }

    match /userAccess/{uid} {
      allow read: if isOwner(uid) || isAdmin();
      allow write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
