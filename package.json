{
  "name": "smartpatrol-local",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test:security": "node --test tests/security/auth-access.test.mjs tests/security/rules-smoke.test.mjs tests/security/trusted-time.test.mjs",
    "firebase:emulate": "firebase emulators:start --only hosting,functions",
